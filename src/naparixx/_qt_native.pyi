"""Internal pointer bridge. Prefer naparixx.qt_host.NativeWidgetHost."""

qt_build_version: str
qt_build_major: int

def qt_runtime_version() -> str: ...

class WidgetHost:
    def __init__(self) -> None: ...
    @property
    def window_address(self) -> int: ...
    @property
    def canvas_address(self) -> int: ...
    @property
    def dock_count(self) -> int: ...
    def add_dock(self, widget_address: int, title: str, area: str = "right") -> int: ...
    def dock_address(self, token: int) -> int: ...
    def detach_dock(self, token: int) -> int: ...
    def set_canvas(self, widget_address: int) -> None: ...
    def take_canvas(self) -> int: ...
    def resize(self, width: int, height: int) -> None: ...
    def show(self) -> None: ...
    def close(self) -> bool: ...
